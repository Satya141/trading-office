# ── Jev via Vercel AI Gateway ───────────────────────────────────────────────
# A Vercel AI Gateway key (starts with vck_). If set, it is used instead of
# TYPESAFE_API_KEY and Jev is reached through the gateway as typesafe-ai/jev.
AI_GATEWAY_API_KEY=

# ── TypeSafe Jev ───────────────────────────────────────────────────────────
# The decision brain for every agent on the floor. Get a key at https://typesafe.ai/
# Leave this blank and the floor still runs — agents fall back to a local
# calibrated heuristic brain. Drop a real key in and every decision becomes Jev.
TYPESAFE_API_KEY=

# Model id. jev-latest is the default.
JEV_MODEL=jev-latest

# ── Local voice model (Ollama) ─────────────────────────────────────────────
# Jev decides; this model puts the decision into words.
OLLAMA_URL=http://localhost:11434
OLLAMA_MODEL=llama3.1:8b

# ── Floor config ───────────────────────────────────────────────────────────
# Deliberately not PORT — dev tooling injects that for the web port.
SERVER_PORT=8787

# Paper trading starting capital, in INR.
STARTING_CAPITAL_INR=2500000

# Symbols the desk covers.
SYMBOLS=BTCUSDT,ETHUSDT,SOLUSDT

# Seconds between market polls.
TICK_SECONDS=5
